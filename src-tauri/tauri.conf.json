{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StyleDNA",
  "version": "0.1.2",
  "identifier": "com.styledna.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StyleDNA",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 700,
        "backgroundColor": "#171715",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Turn images into reusable AI style skills",
    "externalBin": ["binaries/styledna-service"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": { "nsis": { "displayLanguageSelector": false } },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
